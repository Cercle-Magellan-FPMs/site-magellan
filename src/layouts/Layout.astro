---
import Footer from "@components/Footer.astro";
import Nav from "@components/Nav.astro";

import { ClientRouter } from "astro:transitions";

import "@styles/base.css";

interface Props {
  title: string;
}

const { title } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html
  lang="fr-BE"
  class="scroll-p-24 scroll-smooth bg-dark text-white lg:scroll-p-[8.5rem]"
>
  <head>
    <meta charset="utf-8" />
    <meta
      name="title"
      content="Site du Cercle Magellan - Cercle informatique de la Faculté polytechnique de Mons (F.P.Ms)"
    />
    <meta
      name="description"
      content="Bienvenue sur le site du Cercle Magellan, le Cercle informatique de la Faculté polytechnique de Mons (F.P.Ms). Découvrez nos activités, nos services et notre équipe !"
    />
    <meta name="author" content="Cercle Magellan" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalURL} />
    <title>Cercle Magellan{title === "Accueil" ? "" : ` | ${title}`}</title>
    <ClientRouter />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="preload"
      href="/fonts/poppins-regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body class="antialiased" transition:animate="fade">
    <Nav />
    <slot />
    <Footer />
  </body>
</html>
